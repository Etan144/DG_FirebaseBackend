rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       HELPERS
    ========================= */
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isCallParticipant(callId) {
      return signedIn()
        && (
          request.auth.uid ==
            get(/databases/$(database)/documents/calls/$(callId))
              .data.caller_user_id
          ||
          request.auth.uid ==
            get(/databases/$(database)/documents/calls/$(callId))
              .data.callee_user_id
        );
    }

    function isCallSignalingUpdate() {
      return request.resource.data.diff(resource.data)
        .changedKeys().hasOnly([
          "status",
          "offer_sdp",
          "answer_sdp",
          "updated_at",
          "ended_by",
          "ended_reason",
          "ended_at_ms"
        ]);
    }

    function isDetectionUpdate(userId) {
      return request.resource.data.diff(resource.data)
        .changedKeys().hasOnly([
          userId + "_detection_score",
          userId + "_is_deepfake",
          userId + "_detection_timestamp",
          userId + "_highest_detection_score",
          userId + "_highest_detection_timestamp",
          userId + "_highest_is_deepfake"
        ]);
    }

    /* =========================
       PUBLIC USER DIRECTORY
    ========================= */
    match /public_users/{userId} {
      allow read: if signedIn();
      allow write: if false;
    }

    /* =========================
       USERNAME REGISTRY
    ========================= */
    match /usernames/{username} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    /* =========================
       PRIVATE USER PROFILES
    ========================= */
    match /users/{userId} {

      // Admins can read all users
      allow read: if isSelf(userId) || isAdmin();

      // User can only change displayName
      allow update: if isSelf(userId)
        && request.resource.data.diff(resource.data)
             .changedKeys().hasOnly(["displayName","subscription"]);

      allow create, delete: if false;

      /* USER CONTACTS */
      match /contacts/{contactId} {

        allow read: if isSelf(userId);

        allow create: if isSelf(userId)
          && request.resource.data.keys().hasOnly([
            "username",
            "label",
            "createdAt",
            "addedBy"
          ])
          && request.resource.data.addedBy == request.auth.uid;

        allow delete: if isSelf(userId);

        allow update: if isSelf(userId)
          && request.resource.data.diff(resource.data)
               .changedKeys().hasOnly(["label"]);
      }
    }

    /* =========================
       CALL SIGNALING + DETECTION
    ========================= */
    match /calls/{callId} {

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.caller_user_id;

      allow read: if signedIn();

      allow update: if isCallParticipant(callId)
        && (
          isCallSignalingUpdate()
          ||
          isDetectionUpdate(
            get(/databases/$(database)/documents/calls/$(callId))
              .data.caller_user_id
          )
          ||
          isDetectionUpdate(
            get(/databases/$(database)/documents/calls/$(callId))
              .data.callee_user_id
          )
        );

      allow delete: if false;

      /* ICE CANDIDATES */
      match /ice_candidates/{userId} {

        allow get, list: if isCallParticipant(callId);

        match /candidates/{candidateId} {
          allow list, get: if isCallParticipant(callId);
          allow create: if signedIn() && request.auth.uid == userId;
          allow update, delete: if false;
        }
      }
    }

    /* =========================
       CUSTOMER REVIEWS
    ========================= */
    match /reviews/{reviewId} {

      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow delete: if isAdmin();

      allow update: if false;
    }

    /* =========================
       ADMIN AUDIT LOGS
    ========================= */
    match /audit_logs/{logId} {

      allow read: if isAdmin();

      allow create, update, delete: if false;
    }

    /* =========================
       DEFAULT DENY
    ========================= */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}