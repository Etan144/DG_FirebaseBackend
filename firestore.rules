rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       HELPERS
       ========================= */
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isParticipant(callId) {
      let call = get(/databases/$(database)/documents/calls/$(callId)).data;
      return signedIn()
        && (
          request.auth.uid == call.caller_user_id ||
          request.auth.uid == call.callee_user_id
        );
    }

    /* =========================
       PUBLIC USER DIRECTORY
       ========================= */
    match /public_users/{userId} {
      allow read: if signedIn();
      allow write: if false; // Cloud Functions only
    }

    /* =========================
       USERNAME REGISTRY
       ========================= */
    match /usernames/{username} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    /* =========================
       PRIVATE USER PROFILES
       ========================= */
    match /users/{userId} {
      allow read: if isSelf(userId);

      allow update: if isSelf(userId)
        && request.resource.data.diff(resource.data).changedKeys()
             .hasOnly(["displayName"]);

      allow create, delete: if false;
    }

    /* =========================
       CALL SIGNALING
       ========================= */
    match /calls/{callId} {

        // ONLY caller can create call
        allow create: if signedIn()
          && request.auth.uid == request.resource.data.caller_user_id;

        // Participants can READ call docs (query-safe)
        allow read: if signedIn()
          && (
            request.auth.uid == resource.data.caller_user_id ||
            request.auth.uid == resource.data.callee_user_id
          );

        // Participants can UPDATE signaling
        allow update: if signedIn()
          && (
            request.auth.uid == resource.data.caller_user_id ||
            request.auth.uid == resource.data.callee_user_id
          );

        allow delete: if false;

        /* ICE candidates */
        match /ice_candidates/{userId}/candidates/{candidateId} {
          allow create: if signedIn() && request.auth.uid == userId;
          allow read: if signedIn()
            && (
              request.auth.uid == resource.data.caller_user_id ||
              request.auth.uid == resource.data.callee_user_id
            );
          allow update, delete: if false;
        }
      }

    /* =========================
       CUSTOMER REVIEWS
       ========================= */
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if false; // Moderation via Cloud Functions
    }

    /* =========================
       DEFAULT DENY
       ========================= */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
