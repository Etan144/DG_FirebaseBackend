rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       HELPERS
       ========================= */
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.role == "ADMIN";
    }

    function isCallParticipant(callId) {
      return signedIn()
        && (
          request.auth.uid ==
            get(/databases/$(database)/documents/calls/$(callId))
              .data.caller_user_id
          ||
          request.auth.uid ==
            get(/databases/$(database)/documents/calls/$(callId))
              .data.callee_user_id
        );
    }

    /* =========================
       PUBLIC USER DIRECTORY
       ========================= */
    match /public_users/{userId} {
      allow read: if signedIn();
      allow write: if false;
    }

    /* =========================
       USERNAME REGISTRY
       ========================= */
    match /usernames/{username} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    /* =========================
       PRIVATE USER PROFILES
       ========================= */
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();

      allow update: if isSelf(userId)
        && request.resource.data.diff(resource.data)
             .changedKeys().hasOnly(["displayName"]);

      allow create, delete: if false;
      
      /* USER CONTACTS */
         match /contacts/{contactId} {

        // Read own contacts
        allow read: if isSelf(userId);

        // Create new contact
        allow create: if isSelf(userId)
          && request.resource.data.keys().hasOnly([
            "username",
            "label",
            "createdAt",
            "addedBy"
          ])
          && request.resource.data.addedBy == request.auth.uid;

        // Delete own contact
        allow delete: if isSelf(userId);

        // Allow updating the label field (for blocking/unblocking)
        allow update: if isSelf(userId)
          && request.resource.data.diff(resource.data)
               .changedKeys().hasOnly(["label"]);
      }


    }

    /* =========================
       CALL SIGNALING + DETECTION
       ========================= */
    match /calls/{callId} {

      /* ---- CREATE ---- */
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.caller_user_id;

      /* ---- READ (QUERY SAFE) ---- */
      allow read: if signedIn();

      /* ---- UPDATE ---- */
      allow update: if isCallParticipant(callId)
        && (
          request.resource.data.diff(resource.data)
            .changedKeys().hasOnly([
              "status",
              "offer_sdp",
              "answer_sdp",
              "updated_at",
              "ended_by",
              "ended_reason",
              "ended_at_ms"
            ])
          ||
          request.resource.data.diff(resource.data)
            .changedKeys().hasOnly([
              request.auth.uid + "_detection_score",
              request.auth.uid + "_is_deepfake",
              request.auth.uid + "_detection_timestamp"
            ])
        );

      allow delete: if false;

      /* =========================
         ICE CANDIDATES (FIX)
         ========================= */
      match /ice_candidates/{userId} {

        // Needed because Firestore may read the parent doc when attaching the listener
        allow get, list: if isCallParticipant(callId);

        match /candidates/{candidateId} {

          // LIST is required for snapshot listeners
          allow list, get: if isCallParticipant(callId);

          // Each user writes ONLY their own ICE docs
          allow create: if signedIn() && request.auth.uid == userId;

          allow update, delete: if false;
        }
      }
    }

    /* =========================
       CUSTOMER REVIEWS (OPTIONAL)
       ========================= */
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow delete: if isAdmin();
      allow update: if false;
    }
    
    /* =========================
       ADMIN AUDIT LOGS
    ========================= */
    match /audit_logs/{logId} {
      allow read: if isAdmin();

      allow create, update, delete: if false;
    }

    /* =========================
       DEFAULT DENY
       ========================= */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}